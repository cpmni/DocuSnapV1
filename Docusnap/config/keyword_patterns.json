  "validation_patterns": {
    "date": [
      "\\d{1,2}[/\\-.]\\d{1,2}[/\\-.]\\d{2,4}",
      "\\d{4}[/\\-]\\d{2}[/\\-]\\d{2}",
      "\\d{1,2}\\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{2,4}",
      "(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+\\d{1,2},?\\s+\\d{2,4}"
    ],
    "currency": [
      "[\u00a3$\u20ac\u00a5]\\s*[\\d,]+\\.?\\d*",
      "[\\d,]+\\.\\d{2}\\s*(?:GBP|USD|EUR|JPY)?",
      "(?:GBP|USD|EUR)\\s*[\\d,]+\\.?\\d*"
    ],
    "alphanumeric": [
      "[A-Za-z0-9][A-Za-z0-9\\-\\/\\.]{2,20}"
    ],
    "currency_code": [
      "^(?:GBP|USD|EUR|JPY|CAD|AUD|CHF|CNY|INR)$"
    ]
  },
