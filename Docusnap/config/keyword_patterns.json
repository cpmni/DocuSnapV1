  "field_charsets": {
    "_comment": "Phase 1 valid-character policy. BACKEND-ONLY flag (never served via get-validation-patterns; never strips a value). Per field TYPE: the EXTRA non-alphanumeric, non-whitespace chars allowed besides A-Za-z0-9 + whitespace. null = no constraint. 'default' applies to any unlisted type. The engine skips date/currency types.",
    "default": "-'#+&()/\\@:;,.£$%€¥",
    "text": "-'&(),.",
    "alphanumeric": "-./#",
    "ip_address": ".:",
    "mac_address": ":-.",
    "email": "@.-_+%",
    "percentage": ".%",
    "postcode_uk": "",
    "vat_gb": "",
    "reference_code": "-/.",
    "iban": "",
