# DENY BACKSTOP (SEC-02) — this tree deploys with the docroot pointing at public/
# ONLY. If a host ever serves THIS directory instead (the classic shared-hosting
# account-root docroot mistake), these rules are the last wall in front of the
# signing seed, admin secrets and DB creds. keys/.htaccess adds a second wall.
# The deny inherits into public/ — nothing legitimate there matches (no served
# .json/.sql/dotfiles; the /v1 API returns JSON, it doesn't serve .json files).
# Apache-only — on nginx/LiteSpeed the outside-docroot layout is the sole control.
<FilesMatch "(?i)\.(pem|b64|hash|json|key|sql)$|^set-env\.php$|^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
