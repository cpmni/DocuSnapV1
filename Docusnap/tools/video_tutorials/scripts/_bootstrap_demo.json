{
  "version": 1,
  "title": "_bootstrap_demo (internal — record.py runs this silently on a fresh demo profile when the video itself is not the first run)",
  "description": "Create the demo admin → recovery code → Terms → setup wizard (output folder = {{OUTPUT}}) → skip the tour. Placeholders substituted by record.py.",
  "lead_in_sec": 0.2,
  "lead_out_sec": 0.2,
  "app": { "window_title": "ScanFinder", "cdp_port": 9222, "maximize": false },
  "record": { "mode": "screen" },
  "steps": [
    { "id": "settle", "action": "wait",
      "wait_for": { "window": "ScanFinder — Sign in", "selector": "#setup-username", "timeout": 30 },
      "narration": "", "caption": "", "duration_sec": 2.5 },
    { "id": "setup_username", "action": "type_text",
      "target": { "selector": "#setup-username", "window": "ScanFinder — Sign in" }, "text": "{{USER}}",
      "narration": "", "caption": "", "duration_sec": 0.8 },
    { "id": "setup_display", "action": "type_text",
      "target": { "selector": "#setup-display-name", "window": "ScanFinder — Sign in" }, "text": "Demo Admin",
      "narration": "", "caption": "", "duration_sec": 0.8 },
    { "id": "setup_password", "action": "type_text",
      "target": { "selector": "#setup-password", "window": "ScanFinder — Sign in" }, "text": "{{PASS}}",
      "narration": "", "caption": "", "duration_sec": 0.8 },
    { "id": "setup_confirm", "action": "type_text",
      "target": { "selector": "#setup-confirm", "window": "ScanFinder — Sign in" }, "text": "{{PASS}}",
      "narration": "", "caption": "", "duration_sec": 0.8 },
    { "id": "setup_submit", "action": "move_and_click",
      "target": { "selector": "#btn-setup-submit", "window": "ScanFinder — Sign in" },
      "narration": "", "caption": "", "duration_sec": 2 },
    { "id": "recovery_ack", "action": "move_and_click",
      "wait_for": { "window": "ScanFinder — Sign in", "selector": "#recovery-ack", "timeout": 20 },
      "target": { "selector": "#recovery-ack", "window": "ScanFinder — Sign in" },
      "narration": "", "caption": "", "duration_sec": 1 },
    { "id": "recovery_continue", "action": "move_and_click",
      "target": { "selector": "#btn-recovery-continue", "window": "ScanFinder — Sign in" },
      "narration": "", "caption": "", "duration_sec": 2.5 },
    { "id": "terms_tick", "action": "move_and_click", "optional": true,
      "wait_for": { "window": "Scan Finder — Terms of Use", "selector": "#accept-cb", "timeout": 12 },
      "target": { "selector": "#accept-cb", "window": "Scan Finder — Terms of Use" },
      "narration": "", "caption": "", "duration_sec": 1 },
    { "id": "terms_continue", "action": "move_and_click", "optional": true,
      "target": { "selector": "#continue", "window": "Scan Finder — Terms of Use" },
      "narration": "", "caption": "", "duration_sec": 2.5 },
    { "id": "wizard_0", "action": "move_and_click",
      "wait_for": { "window": "Welcome to Scan Finder", "selector": "#nextBtn", "timeout": 20 },
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" },
      "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "wizard_1", "action": "move_and_click",
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" }, "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "wizard_2", "action": "move_and_click",
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" }, "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "wizard_3", "action": "move_and_click",
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" }, "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "wizard_4", "action": "move_and_click",
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" }, "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "wizard_5", "action": "move_and_click",
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" }, "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "wizard_6", "action": "move_and_click",
      "target": { "selector": "#nextBtn", "window": "Welcome to Scan Finder" }, "narration": "", "caption": "", "duration_sec": 3 },
    { "id": "tour_skip", "action": "move_and_click", "optional": true,
      "wait_for": { "window": "Welcome to Scan Finder", "selector": "#skip", "timeout": 12 },
      "target": { "selector": "#skip", "window": "Welcome to Scan Finder" },
      "narration": "", "caption": "", "duration_sec": 1.5 },
    { "id": "main_focus", "action": "focus_window", "window": "ScanFinder", "maximize": true, "timeout": 30,
      "narration": "", "caption": "", "duration_sec": 1 }
  ]
}
