vendor/ollama_models/
vendor/tesseract/tessdata/
vendor/ollama/
vendor/python_env/
vendor/python/
vendor/python_venv_backup/
vendor/tesseract/
dist/
node_modules/
__pycache__/
*.pyc
*.pyo
/processing.log
/processing_test.log

# Diagnostic logs (per-session JSONL + processing logs) — contain extracted
# document data; local diagnostic artefacts only, never committed.
Debug/
*.jsonl

# Licensing signing keys — private keys must NEVER be committed or bundled.
# Generated by licensing-backend/scripts/generate_keys.js; live only on the host.
licensing-backend/keys/

# PHP per-directory config — host/deploy-specific. .user.ini carries the
# auto_prepend_file path to set-env.php and other per-host PHP settings (a
# REPLACE_ME template from Build-IonosDeploy, or the live host paths). Never committed.
licensing-backend/**/.user.ini

# Claude Code: machine-local settings + transient worktrees (the shared
# agents/ and skills/ ARE committed). settings.local.json holds per-host config.
.claude/settings.local.json
.claude/worktrees/

# Runtime-learned templates: the app writes these to templatesDir (the repo
# templates/ dir in dev, userData when packaged) via _writeTemplateFile. They are
# per-install learned data, NOT shipped (not in build files/extraResources), so they
# must never be committed.
templates/*.json

# Private TLS key material must NEVER be committed (SECURITY_AUDIT.md F-07). The
# Samples/ tree holds throwaway demo certs (incl. ca.key / server.key / server.pfx,
# all of which carry a private key); ignore the whole tree, plus a belt-and-braces
# global rule for any stray private-key file anywhere in the repo.
Samples/
*.key
*.pfx
*.p12
