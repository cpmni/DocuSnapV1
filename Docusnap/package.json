{
  "name": "docusnap",
  "version": "2.0.0",
  "description": "Local document OCR and field extraction",
  "author": "Six Mile Software",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/dev-start.js",
    "build": "node scripts/check-release-migrations.js && node scripts/check-vendor-python.js && node scripts/check-licenses.js && node scripts/compile-python-bytecode.js && node scripts/test_no_shipped_py_source.js && node scripts/build-electron.js",
    "build:release": "node scripts/build-release.js nsis",
    "build:release:store": "node scripts/build-release.js appx",
    "build:test": "node scripts/build-release.js nsis --test",
    "check:licenses": "node scripts/check-licenses.js",
    "check:vendor": "node scripts/check-vendor-python.js",
    "check:help": "node scripts/check-help-coverage.js",
    "build:store": "node scripts/check-release-migrations.js && node scripts/check-vendor-python.js && node scripts/check-licenses.js && node scripts/compile-python-bytecode.js && node scripts/test_no_shipped_py_source.js && node scripts/build-electron.js appx",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.scanfinder.app",
    "productName": "ScanFinder",
    "copyright": "Copyright © 2026 Six Mile Software",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "ScanFinder Setup ${version}-r${env.BUILD_REV}.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScanFinder",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "license": "LEGAL.txt"
    },
    "appx": {
      "identityName": "SixMileSoftware.ScanFinder",
      "publisher": "CN=Six Mile Software",
      "publisherDisplayName": "Six Mile Software",
      "applicationId": "ScanFinder",
      "backgroundColor": "#0c0e14",
      "languages": [
        "en-US"
      ],
      "artifactName": "ScanFinder-${version}.appx"
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      },
      {
        "from": "LEGAL.txt",
        "to": "LEGAL.txt"
      },
      {
        "from": "build_python/",
        "to": "python_backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "config/",
        "to": "config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/tutorial-samples/",
        "to": "assets/tutorial-samples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "database/**/*",
      "assets/**/*",
      "package.json",
      "!**/test_*.js",
      "!**/*.test.js",
      "!**/__tests__/**",
      "!**/*.map",
      "!src/index.html",
      "!src/review.html",
      "!src/settings.html",
      "!src/renderer.js",
      "!src/review_renderer.js",
      "!src/settings_renderer.js"
    ],
    "asarUnpack": [
      "**/*.node",
      "assets/icon.ico"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.6.0"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "bytenode": "^1.6.0",
    "node-forge": "1.4.0",
    "pdf-lib": "^1.17.1"
  }
}
