{
  "app": "<div id=\"app\">\n  <div id=\"titlebar\">\n    <span class=\"tb-title\">ScanFinder — Search</span>\n    <div class=\"tb-right\">\n      <button class=\"tb-btn help-guide-btn\" id=\"btn-help-guide\" title=\"Open the user guide (Search)\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"></path><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"></path></svg></button>\n      <button class=\"tb-btn\" id=\"help-mode-toggle\" data-help-key=\"help-mode\" title=\"Help mode — click, then click any control to learn what it does\">?</button>\n      <button class=\"tb-btn close\" id=\"btn-close\" title=\"Close\">×</button>\n    </div>\n  </div>\n\n  <div id=\"search-bar\">\n    <span class=\"lead-wrap\">\n      <svg class=\"lead-ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg>\n      <input class=\"search-input\" id=\"inp-fulltext\" type=\"text\" placeholder=\"Search anything…\" title=\"Searches everything on the document — text, references, amounts, dates and codes. Numbers ignore commas (1137 finds 1,137).\" data-help-key=\"fulltext\">\n    </span>\n    <span style=\"font-size:11px; color:var(--muted); white-space:nowrap;\">From</span>\n    <input class=\"search-input\" id=\"inp-date-from\" data-help-key=\"date-from\" type=\"date\" title=\"From date\">\n    <span style=\"font-size:11px; color:var(--muted);\">to</span>\n    <input class=\"search-input\" id=\"inp-date-to\" type=\"date\" title=\"To date\">\n    <select id=\"inp-total-op\" class=\"search-input\" title=\"Total amount filter\" style=\"width:auto;\" data-help-key=\"total-op\">\n      <option value=\"eq\">Total =</option>\n      <option value=\"gt\">Total &gt;</option>\n      <option value=\"lt\">Total &lt;</option>\n    </select>\n    <input class=\"search-input\" id=\"inp-total\" type=\"text\" inputmode=\"decimal\" placeholder=\"amount\" title=\"Filter by total amount (uses the operator on the left)\" style=\"width:90px;\" data-help-key=\"total\">\n    <select id=\"inp-type\" data-help-key=\"type-filter\" title=\"Limit results to one document type (e.g. only Invoices).\">\n      <option value=\"\">All types</option>\n    <option value=\"invoice\">Invoice</option><option value=\"purchase_order\">Purchase Order</option></select>\n    <label class=\"uncommitted-toggle\" data-help-key=\"uncommitted\">\n      <input type=\"checkbox\" id=\"chk-uncommitted\" checked=\"\">\n      Include unconfirmed\n    </label>\n    <button id=\"btn-search\" data-help-key=\"do-search\" title=\"Run the search. Results also update automatically as you type.\">Search</button>\n    <button id=\"btn-recycle\" data-help-key=\"recycle-bin\" style=\"\" title=\"View deleted documents. Restore them, or (admin) delete permanently. Delete sends a document here — it&amp;rsquo;s recoverable.\">Recycle bin</button>\n    <button id=\"btn-restore-all\" style=\"display:none\">Restore all</button>\n    <button id=\"btn-empty-bin\" style=\"display:none\">Empty bin</button>\n    <button id=\"btn-mailbox\" data-help-key=\"mailbox\" style=\"display:none\" title=\"Show documents shared with you for approval or acknowledgement (if enabled).\">Mailbox</button>\n  </div>\n  <div id=\"date-range-note\" style=\"display:none; padding:2px 12px; font-size:12px; color:var(--warn);\">\n    “From” date is after “To” date — no documents can match. Swap them or clear one.\n  </div>\n\n  <div id=\"body\">\n    <div id=\"results-pane\" data-help-key=\"results-pane\">\n      <div id=\"mailbox-tabs\" style=\"display:none\">\n        <button class=\"mb-tab active\" data-box=\"inbox\">Inbox</button>\n        <button class=\"mb-tab\" data-box=\"sent\">Sent</button>\n        <!-- \"Assigned\" (= routes YOU have CLAIMED but not resolved) is HIDDEN on the desktop:\n             the desktop decision bar resolves straight from pending and never claims, so this\n             box is structurally always empty here — it only fills via the detached client's\n             claim flow (Chris r4 card 6 + eric A6; bob's honest-cut ruling). Un-hide when\n             desktop claiming exists. -->\n        <button class=\"mb-tab\" data-box=\"assigned\" style=\"display:none;\">Assigned</button>\n        <button class=\"mb-tab\" data-box=\"completed\">Completed</button>\n      </div>\n      <div id=\"results-body\">\n        <div id=\"results-scroll\">\n          <div id=\"results-empty\" style=\"display:none\">No documents found</div>\n        <div class=\"section-header\">CONFIRMED <span class=\"section-count\">2</span></div><div class=\"result-item\" data-id=\"1\">\n    <div class=\"result-row\">\n      <span class=\"result-thumb\"><img class=\"result-thumb-img loaded\" alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==\"></span>\n      <div class=\"result-main\">\n        <div class=\"result-header\">\n          <span class=\"result-supplier\" title=\"Acme Ltd\">Acme Ltd</span>\n          <span class=\"result-status-badge confirmed\">Confirmed</span>\n        </div>\n        <div class=\"result-detail\" title=\"INV-001 · 12-03-2026 · Invoice\">INV-001  ·  12-03-2026  ·  Invoice</div>\n        \n      </div>\n    </div>\n  </div><div class=\"result-item\" data-id=\"2\">\n    <div class=\"result-row\">\n      <span class=\"result-thumb\"><img class=\"result-thumb-img loaded\" alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==\"></span>\n      <div class=\"result-main\">\n        <div class=\"result-header\">\n          <span class=\"result-supplier\" title=\"Bolt Supplies\">Bolt Supplies</span>\n          <span class=\"result-status-badge confirmed\">Confirmed</span>\n        </div>\n        <div class=\"result-detail\" title=\"INV-002 · 14-03-2026 · Invoice\">INV-002  ·  14-03-2026  ·  Invoice</div>\n        \n      </div>\n    </div>\n  </div><div class=\"section-header\">UNCONFIRMED <span class=\"section-count\">1</span></div><div class=\"result-item\" data-id=\"3\">\n    <div class=\"result-row\">\n      <span class=\"result-thumb\"><img class=\"result-thumb-img loaded\" alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==\"></span>\n      <div class=\"result-main\">\n        <div class=\"result-header\">\n          <span class=\"result-supplier\" title=\"Cable Co\">Cable Co</span>\n          <span class=\"result-status-badge review\">Needs Review</span>\n        </div>\n        <div class=\"result-detail\" title=\"PO-7 · Purchase Order\">PO-7  ·  Purchase Order</div>\n        \n      </div>\n    </div>\n  </div></div>\n        <!-- Vertical tool rail (mirrors the Review window): document cycle at the top,\n             then the document tools. Buttons reveal by role/mode via search-results.js. -->\n        <div id=\"search-scroll-rail\">\n          <div class=\"rail-group rail-nav-group\">\n            <button class=\"queue-nav-btn\" id=\"btn-doc-prev\" title=\"Previous document (↑)\" aria-label=\"Previous document\" disabled=\"\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 15l6-6 6 6\"></path></svg>\n            </button>\n            <button class=\"queue-nav-btn\" id=\"btn-doc-next\" title=\"Next document (↓)\" aria-label=\"Next document\" disabled=\"\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"></path></svg>\n            </button>\n          </div>\n          <div class=\"rail-divider rail-divider-clear\"></div>\n          <div class=\"rail-group rail-tools-group\">\n            <button class=\"queue-tool-btn danger\" id=\"rail-delete\" style=\"display:none\" title=\"Delete (move to recycle bin)\" aria-label=\"Delete\" disabled=\"\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h18\"></path><path d=\"M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2\"></path><path d=\"M19 6l-1 14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6\"></path><path d=\"M10 11v6M14 11v6\"></path></svg>\n            </button>\n            <button class=\"queue-tool-btn\" id=\"rail-restore\" style=\"display:none\" title=\"Restore from recycle bin\" aria-label=\"Restore\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 3-6.7\"></path><path d=\"M3 4v4h4\"></path></svg>\n            </button>\n            <button class=\"queue-tool-btn\" id=\"rail-sendback\" style=\"display:none\" title=\"Send back to Review (admin) — re-open a filed document in the queue\" aria-label=\"Send back to Review\" disabled=\"\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 14L4 9l5-5\"></path><path d=\"M4 9h11a5 5 0 0 1 5 5v0a5 5 0 0 1-5 5H9\"></path></svg>\n            </button>\n            <button class=\"queue-tool-btn\" id=\"rail-recycle\" style=\"display:none\" title=\"Show the recycle bin\" aria-label=\"Recycle bin\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5\"></path><path d=\"M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12\"></path><path d=\"m14 16-3 3 3 3\"></path><path d=\"M8.293 13.596 7.196 9.5 3.1 10.598\"></path><path d=\"m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843\"></path><path d=\"m13.378 9.633 4.096 1.098 1.097-4.096\"></path></svg>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"preview-pane\" data-help-key=\"preview-pane\">\n      <div id=\"preview-empty\">Select a document from the results</div>\n\n      <div id=\"preview-doc\" style=\"display:none\">\n        <div id=\"preview-img-col\">\n          <div id=\"page-nav\" style=\"display:none\">\n            <div class=\"pn-group\" data-help-key=\"preview-zoom\">\n              <span class=\"pn-label\">Zoom</span>\n              <button class=\"page-nav-btn\" id=\"btn-zoom-out\" title=\"Zoom out\" aria-label=\"Zoom out\">−</button>\n              <span id=\"zoom-level\" class=\"page-nav-label\">100%</span>\n              <button class=\"page-nav-btn\" id=\"btn-zoom-in\" title=\"Zoom in\" aria-label=\"Zoom in\">+</button>\n              <button class=\"page-nav-btn pn-wide\" id=\"btn-zoom-reset\" title=\"Reset zoom &amp; position\">Reset</button>\n            </div>\n            <div class=\"pn-sep pn-pages\"></div>\n            <div class=\"pn-group pn-pages\">\n              <span class=\"pn-label\">Page</span>\n              <button class=\"page-nav-btn\" id=\"btn-page-prev\" data-help-key=\"preview-pages\" title=\"Previous page\" aria-label=\"Previous page\" disabled=\"\">‹</button>\n              <span id=\"page-label\" class=\"page-nav-label\">1 / 1</span>\n              <button class=\"page-nav-btn\" id=\"btn-page-next\" data-help-key=\"preview-pages\" title=\"Next page\" aria-label=\"Next page\" disabled=\"\">›</button>\n            </div>\n            <div class=\"pn-sep\" id=\"match-sep\" style=\"display:none\"></div>\n            <div class=\"pn-group mn-group\" id=\"match-nav\" data-help-key=\"preview-find\" style=\"display:none\">\n              <span class=\"pn-label mn-cap\"><svg class=\"mn-ico\" viewBox=\"0 0 16 16\" width=\"12\" height=\"12\" aria-hidden=\"true\"><circle cx=\"6.5\" cy=\"6.5\" r=\"4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle><line x1=\"10\" y1=\"10\" x2=\"14\" y2=\"14\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"></line></svg>Find</span>\n              <input type=\"text\" id=\"inp-find-doc\" class=\"mn-input\" placeholder=\"in this document…\" title=\"Find text in this document (PDF text). Enter = next match, Shift+Enter = previous, Esc = clear.\" autocomplete=\"off\" spellcheck=\"false\">\n              <button class=\"page-nav-btn mn-btn\" id=\"btn-match-prev\" title=\"Previous match\" aria-label=\"Previous match\" disabled=\"\">‹</button>\n              <span id=\"match-label\" class=\"page-nav-label mn-count\">0 / 0</span>\n              <button class=\"page-nav-btn mn-btn\" id=\"btn-match-next\" title=\"Next match\" aria-label=\"Next match\" disabled=\"\">›</button>\n            </div>\n          </div>\n          <div id=\"preview-img-area\" data-help-key=\"preview-zoom\">\n            <span id=\"preview-img-placeholder\">Loading…</span>\n            <div id=\"preview-img-wrap\" style=\"display:none\"><img id=\"preview-img\" alt=\"Document preview\" draggable=\"false\"><div id=\"preview-hl-layer\"></div></div>\n          </div>\n        </div>\n\n        <div id=\"sidebar-resizer\" title=\"Drag to resize the details column\"></div>\n        <div id=\"preview-sidebar\">\n          <div id=\"preview-fields-scroll\"></div>\n          <div id=\"preview-actions\" data-help-key=\"preview-actions\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
  "appChildren": [
    "titlebar",
    "search-bar",
    "date-range-note",
    "body"
  ],
