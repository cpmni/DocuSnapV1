{
  "name": "scanfinder-client",
  "version": "1.0.2",
  "private": true,
  "description": "Detached read-only search client for ScanFinder (connects to the core app's /v1 API).",
  "author": "Six Mile Software",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node -e \"const c=require('child_process');process.env.BUILD_REV=require('../scripts/build-rev').buildRev();c.execSync('electron-builder --win --x64 --config.extraMetadata.buildRev=' + process.env.BUILD_REV,{stdio:'inherit',env:process.env})\""
  },
  "build": {
    "appId": "com.scanfinder.client",
    "productName": "ScanFinder Search Client",
    "copyright": "Copyright © 2026 Six Mile Software",
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "ScanFinder Search Client Setup ${version}-r${env.BUILD_REV}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScanFinder Search Client",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "apiClient.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  }
}
